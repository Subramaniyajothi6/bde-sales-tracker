# Copy this file to .env and fill in the values.
# Moving to a paid server/domain later only means changing this file.

# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://bde_app:change-me@localhost:3306/bde_tracker"

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000
# development | production  (production turns on secure cookies)
NODE_ENV=development

# Address of the web app. Needed only when the web app runs on a different
# address than this API (e.g. during development with Vite on :5173).
WEB_ORIGIN="http://localhost:5173"

# Where receipt files are kept. "local" = a folder on this server.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Daily report cutoff, India time (24-hour clock)
REPORT_CUTOFF=19:30
# Starting the day (punch in) after this time counts as late, India time
LATE_AFTER=10:00

# Used once by `npm run db:seed` to create the first admin account (ADMIN-01).
SEED_ADMIN_PASSWORD="change-this-admin-password"
# true = also create 30 sample BDEs with sample leads and calls (for demos only)
SEED_SAMPLE_DATA=false
