// Database design for the BDE Team Management & Sales Tracking app.
// See docs/DECISIONS.md for why the tables look like this.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BDE
}

enum CourseType {
  COURSE
  INTERNSHIP
}

enum LeadStage {
  /// Imported from a sheet and not called yet
  NEW
  INTERESTED
  FOLLOW_UP
  INTERVIEW_SCHEDULED
  SELECTED
  PAYMENT_COMMITTED
  PAID
  NOT_INTERESTED
}

enum CallOutcome {
  INTERESTED
  CALL_BACK
  NOT_INTERESTED
  NO_ANSWER
}

enum InterviewStatus {
  SCHEDULED
  ATTENDED
  NO_SHOW
}

enum InterviewResult {
  SELECTED
  NOT_SELECTED
}

enum PaymentStatus {
  PROMISED
  PARTIALLY_PAID
  PAID
}

enum ReceiptCheck {
  TO_VERIFY
  VERIFIED
  REJECTED
}

/// Admins and BDEs. Nobody is deleted: deactivated users keep their history.
model User {
  id                 Int       @id @default(autoincrement())
  employeeId         String    @unique @db.VarChar(20)
  name               String    @db.VarChar(100)
  phone              String    @db.VarChar(20)
  email              String?   @db.VarChar(150)
  role               Role      @default(BDE)
  passwordHash       String    @db.VarChar(100)
  mustChangePassword Boolean   @default(true)
  /// Raised on password reset or deactivation so old logins stop working.
  tokenVersion       Int       @default(0)
  active             Boolean   @default(true)
  dailyTarget        Int       @default(80)
  joinedOn           DateTime  @db.Date
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  leads           Lead[]           @relation("LeadOwner")
  notes           LeadNote[]
  calls           CallLog[]
  reports         DailyReport[]
  interviews      Interview[]      @relation("InterviewCreator")
  payments        Payment[]        @relation("PaymentRecorder")
  verified        Payment[]        @relation("PaymentVerifier")
  attendance      Attendance[]
  leaves          Leave[]          @relation("LeaveOwner")
  leavesDecided   Leave[]          @relation("LeaveDecider")
  activity        Activity[]
  sent            Message[]        @relation("MessageSender")
  received        Message[]        @relation("MessageRecipient")
  channelMessages ChannelMessage[]
  channelReads    ChannelRead[]
  notifications   Notification[]
  importBatches   ImportBatch[]
}

model Course {
  id     Int        @id @default(autoincrement())
  name   String     @db.VarChar(120)
  type   CourseType
  /// Full fee in whole rupees
  fee    Int
  active Boolean    @default(true)
  leads  Lead[]
}

/// A candidate. One phone number belongs to one lead.
model Lead {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  /// Last 10 digits only, so +91 98765 43210 and 9876543210 match
  phone      String    @unique @db.VarChar(10)
  courseId   Int
  ownerId    Int
  stage      LeadStage @default(INTERESTED)
  followUpOn DateTime? @db.Date
  nextAction String?   @db.VarChar(200)
  /// The admin's import this lead came from, if any (for tracking each batch)
  batchId    Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  course     Course       @relation(fields: [courseId], references: [id])
  owner      User         @relation("LeadOwner", fields: [ownerId], references: [id])
  batch      ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  notes      LeadNote[]
  interviews Interview[]
  payments   Payment[]
  calls      CallLog[]

  @@index([ownerId, stage])
  @@index([batchId])
  @@index([followUpOn])
}

enum NoteSource {
  PAGE
  CALL
  SHEET
  IMPORT
}

model LeadNote {
  id        Int      @id @default(autoincrement())
  leadId    Int
  authorId  Int
  text      String   @db.VarChar(500)
  /// Where the change was made: the lead page, the call list on Today, an Excel upload, or an import
  source    NoteSource @default(PAGE)
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId])
}

/// One row per call a BDE logs. Daily report numbers are counted from these.
model CallLog {
  id       Int         @id @default(autoincrement())
  bdeId    Int
  outcome  CallOutcome
  calledAt DateTime    @default(now())
  /// India date the call belongs to
  workDate DateTime    @db.Date
  /// The student called, picked from the call list on Today; empty for a new number
  leadId   Int?
  /// The student's status, follow-up and next action before and after this call, so a wrong tap can be undone
  undo     Json?

  bde  User  @relation(fields: [bdeId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([bdeId, workDate])
  @@index([workDate])
  @@index([leadId])
}

/// Marks a day's report as sent. Numbers come from CallLog.
model DailyReport {
  id          Int       @id @default(autoincrement())
  bdeId       Int
  workDate    DateTime  @db.Date
  submittedAt DateTime?
  /// Optional note for the admin: problems, anything to flag
  note        String?   @db.VarChar(500)

  bde User @relation(fields: [bdeId], references: [id])

  @@unique([bdeId, workDate])
}

model Interview {
  id          Int              @id @default(autoincrement())
  leadId      Int
  createdById Int
  scheduledAt DateTime
  status      InterviewStatus  @default(SCHEDULED)
  result      InterviewResult?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User @relation("InterviewCreator", fields: [createdById], references: [id])

  @@index([scheduledAt])
}

/// A promise to pay (PROMISED) or money received (PARTIALLY_PAID / PAID).
model Payment {
  id           Int           @id @default(autoincrement())
  leadId       Int
  recordedById Int
  /// Whole rupees
  amount       Int
  status       PaymentStatus
  /// Date paid, or the date the candidate promised to pay
  date         DateTime      @db.Date
  note         String?       @db.VarChar(300)

  // Receipt, required for money received
  receiptKey   String?       @db.VarChar(200)
  receiptName  String?       @db.VarChar(200)
  receiptType  String?       @db.VarChar(80)
  check        ReceiptCheck?
  rejectReason String?       @db.VarChar(200)
  verifiedById Int?
  verifiedAt   DateTime?

  /// For promises: set when money arrives, so it leaves the "promised" list
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recordedBy User  @relation("PaymentRecorder", fields: [recordedById], references: [id])
  verifiedBy User? @relation("PaymentVerifier", fields: [verifiedById], references: [id])

  @@index([leadId])
  @@index([date])
  @@index([check])
}

enum LeaveType {
  CASUAL
  SICK
  EMERGENCY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// One row per BDE per working day: when they started and finished.
model Attendance {
  id       Int       @id @default(autoincrement())
  userId   Int
  /// India date
  workDate DateTime  @db.Date
  punchIn  DateTime
  /// Set when the day's report is sent; cleared if the report is reopened
  punchOut DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, workDate])
  @@index([workDate])
}

/// A BDE's leave request. Approved leave days count as "Leave", not "Absent".
model Leave {
  id           Int         @id @default(autoincrement())
  userId       Int
  type         LeaveType
  fromDate     DateTime    @db.Date
  toDate       DateTime    @db.Date
  reason       String      @db.VarChar(300)
  status       LeaveStatus @default(PENDING)
  decidedById  Int?
  decidedAt    DateTime?
  decisionNote String?     @db.VarChar(200)
  createdAt    DateTime    @default(now())

  user      User  @relation("LeaveOwner", fields: [userId], references: [id])
  decidedBy User? @relation("LeaveDecider", fields: [decidedById], references: [id])

  @@index([userId, fromDate])
  @@index([status])
}

/// Who did what and when, for the admin's activity log.
model Activity {
  id        Int      @id @default(autoincrement())
  userId    Int
  /// Short code, e.g. LOGIN, PUNCH_IN, LEAD_ADDED (see lib/activity.ts)
  action    String   @db.VarChar(30)
  detail    String   @db.VarChar(300)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// A direct chat message between two people.
model Message {
  id          Int       @id @default(autoincrement())
  senderId    Int
  recipientId Int
  text        String    @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  sender    User @relation("MessageSender", fields: [senderId], references: [id])
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id])

  @@index([senderId, recipientId, id])
  @@index([recipientId, readAt])
}

/// A group chat room. Created by the migration: general, team, announcements.
model Channel {
  id            Int      @id @default(autoincrement())
  /// Short name used in addresses, e.g. "general"
  key           String   @unique @db.VarChar(40)
  name          String   @db.VarChar(60)
  description   String   @db.VarChar(200)
  /// Only admins can post (announcements); everyone can read
  adminOnlyPost Boolean  @default(false)
  createdAt     DateTime @default(now())

  messages ChannelMessage[]
  reads    ChannelRead[]
}

model ChannelMessage {
  id        Int      @id @default(autoincrement())
  channelId Int
  senderId  Int
  text      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id])
  sender  User    @relation(fields: [senderId], references: [id])

  @@index([channelId, id])
}

/// The newest channel message a person has seen, for unread counts.
model ChannelRead {
  userId     Int
  channelId  Int
  lastReadId Int @default(0)

  user    User    @relation(fields: [userId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@id([userId, channelId])
}

/// One item under the bell, e.g. "Your leave for 20 Oct was approved".
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  /// Short code, e.g. LEAVE_ANSWERED (see lib/notify.ts)
  kind      String    @db.VarChar(30)
  title     String    @db.VarChar(200)
  /// Page to open when clicked, e.g. /bde/me
  link      String?   @db.VarChar(200)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, id])
  @@index([userId, readAt])
}

/// A receipt file kept in the database (STORAGE_DRIVER=db), for hosts whose disk is wiped on restart.
model StoredFile {
  /// Same key the folder storage would use, e.g. receipts/2026/10/<uuid>.png
  key       String   @id @db.VarChar(200)
  /// Uploads are at most 5 MB
  data      Bytes    @db.MediumBlob
  createdAt DateTime @default(now())
}

/// One bulk import of students by the admin. Its leads are tracked together on the Leads page.
model ImportBatch {
  id          Int      @id @default(autoincrement())
  fileName    String   @db.VarChar(200)
  createdById Int
  /// Leads created by the import
  count       Int
  createdAt   DateTime @default(now())

  createdBy User   @relation(fields: [createdById], references: [id])
  leads     Lead[]
}
